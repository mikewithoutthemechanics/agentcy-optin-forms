{
  "name": "Agentcy Opt-In → Airtable Tracker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentcy-trades-optin",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook: Trades Opt-In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentcy-online-smb-optin",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "2",
      "name": "Webhook: Online SMB Opt-In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 450]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentcy-prof-services-optin",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "3",
      "name": "Webhook: Prof Services Opt-In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            { "name": "Name", "value": "={{ $json.name }}" },
            { "name": "Business", "value": "={{ $json.business }}" },
            { "name": "Segment", "value": "={{ $json.segment }}" },
            { "name": "Area", "value": "={{ $json.area || '' }}" },
            { "name": "Preferred Channel", "value": "={{ $json.preferred_channel }}" },
            { "name": "Pain Point", "value": "={{ $json.pain_point }}" },
            { "name": "Current Tools", "value": "={{ $json.current_tools || '' }}" },
            { "name": "POPIA Consent", "value": "={{ $json.popia_consent }}" },
            { "name": "Consent Basis", "value": "={{ $json.consent_basis || 'Form Opt-In' }}" },
            { "name": "Source", "value": "={{ $json.source || 'website' }}" },
            { "name": "Opt-In Date", "value": "={{ $json.optin_date || new Date().toISOString().split('T')[0] }}" },
            { "name": "Status", "value": "New Opt-In" },
            { "name": "Booked Call", "value": "No" },
            { "name": "Attended", "value": "No" },
            { "name": "Qualified", "value": "No" },
            { "name": "Proposal Sent", "value": "No" },
            { "name": "Outcome", "value": "" },
            { "name": "Next Action", "value": "Send lead magnet + schedule follow-up" },
            { "name": "Next Follow-Up Date", "value": "={{ new Date(Date.now() + 2*24*60*60*1000).toISOString().split('T')[0] }}" },
            { "name": "Touch Count", "value": 0 },
            { "name": "Last Touch Date", "value": "={{ new Date().toISOString().split('T')[0] }}" },
            { "name": "Lead Magnet", "value": "={{ $json.lead_magnet }}" }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Map to Airtable Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [500, 450]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "app0CK3JUNYEGcCMV",
        "tableId": "tblnhzmqneNswTvGd",
        "options": {}
      },
      "id": "5",
      "name": "Create Airtable Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [750, 450],
      "credentials": { "airtableApi": "Agentcy Airtable" }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseData": {
          "success": true,
          "message": "Opt-in recorded. Lead magnet incoming."
        }
      },
      "id": "6",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 450]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseData": {
          "success": false,
          "message": "Failed to record opt-in"
        }
      },
      "id": "7",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 600]
    }
  ],
  "connections": {
    "Webhook: Trades Opt-In": { "main": [[{ "node": "Map to Airtable Fields", "type": "main", "index": 0 }]] },
    "Webhook: Online SMB Opt-In": { "main": [[{ "node": "Map to Airtable Fields", "type": "main", "index": 0 }]] },
    "Webhook: Prof Services Opt-In": { "main": [[{ "node": "Map to Airtable Fields", "type": "main", "index": 0 }]] },
    "Map to Airtable Fields": { "main": [[{ "node": "Create Airtable Record", "type": "main", "index": 0 }]] },
    "Create Airtable Record": {
      "main": [
        [{ "node": "Success Response", "type": "main", "index": 0 }],
        [{ "node": "Error Response", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {},
  "id": "agentcy-optin-tracker"
}